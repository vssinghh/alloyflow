<mujoco model="alloyflow_so101_scene">
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.30 0.30 0.32" specular="0.15 0.15 0.15"/>
    <quality shadowsize="2048" offsamples="4"/>
    <global offwidth="640" offheight="480" azimuth="145" elevation="-25"/>
  </visual>

  <include file="so101_arm.xml"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.88 0.91 0.95" rgb2="0.68 0.74 0.82" width="512" height="3072"/>
    <texture name="wood_tex" type="2d" builtin="flat" rgb1="0.76 0.60 0.42" rgb2="0.72 0.56 0.38" width="256" height="256"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.22 0.24 0.27" rgb2="0.18 0.20 0.22" width="256" height="256"/>

    <mesh file="bowl_outer.stl"/>
    <mesh file="bowl_inner.stl"/>

    <material name="wood_table" rgba="0.78 0.60 0.42 1" specular="0.15" shininess="0.2" reflectance="0.03"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6" texuniform="true" reflectance="0.05"/>
    <material name="pen_holder_mat" rgba="0.20 0.38 0.68 1" specular="0.25" shininess="0.35"/>
    <material name="cup_mat" rgba="0.88 0.36 0.25 1" specular="0.30" shininess="0.40"/>
    <material name="bowl_mat" rgba="0.14 0.56 0.52 1" specular="0.45" shininess="0.60"/>
    <material name="bowl_inner_mat" rgba="0.93 0.91 0.85 1" specular="0.40" shininess="0.55"/>
    <material name="cube_core_mat" rgba="0.10 0.10 0.12 1" specular="0.20" shininess="0.30"/>
  </asset>

  <worldbody>
    <!-- Studio Lighting -->
    <light name="main_light" pos="0.25 -0.20 0.95" dir="0.0 0.15 -0.98" diffuse="0.75 0.75 0.72" specular="0.25 0.25 0.25" directional="false" castshadow="true"/>
    <light name="fill_light" pos="0.30 0.35 0.85" dir="-0.1 -0.25 -0.96" diffuse="0.40 0.42 0.45" specular="0.10 0.10 0.10" directional="false" castshadow="false"/>

    <!-- Floor & Tabletop Surface (Tabletop top surface is at Z = 0.0) -->
    <geom name="floor" type="plane" pos="0 0 -0.72" size="2.0 2.0 0.05" material="floor_mat" contype="1" conaffinity="1"/>
    <body name="table" pos="0.20 0.0 -0.02">
      <geom name="desk_top" type="box" pos="0 0 0" size="0.35 0.38 0.02" material="wood_table" contype="1" conaffinity="1" friction="0.9 0.02 0.01"/>
    </body>

    <!-- External Cameras (128x128 synchronized RGB streams with >=12px workspace margin) -->
    <camera name="third_person_cam" pos="0.55 -0.27 0.33" xyaxes="0.45 0.893 0.0 -0.46 0.23 0.85" fovy="55"/>
    <camera name="overhead_cam" pos="0.24 0.0 0.54" xyaxes="0.0 -1.0 0.0 1.0 0.0 0.0" fovy="55"/>

    <!-- Object 1: Pen Holder (Tall square desktop pen caddy with stepped base, ~3.2 cm wide, 6.6 cm tall) -->
    <body name="pen_holder" pos="0.22 0.12 0.035">
      <freejoint name="pen_holder_joint"/>
      <inertial pos="0 0 -0.006" mass="0.050" diaginertia="2.4e-5 2.4e-5 1.4e-5"/>
      <!-- Visual square desk caddy geoms (group 2, non-colliding so square corners never wedge) -->
      <geom name="pen_holder_visual_base" type="box" pos="0 0 -0.031" size="0.018 0.018 0.004" material="pen_holder_mat" contype="0" conaffinity="0" group="2"/>
      <geom name="pen_holder_visual_body" type="box" pos="0 0 0.0" size="0.0145 0.0145 0.028" material="pen_holder_mat" contype="0" conaffinity="0" group="2"/>
      <!-- Smooth cylindrical collision proxy (group 3) for yaw-invariant grasping and bowl seating -->
      <geom name="pen_holder_base" type="cylinder" pos="0 0 -0.031" size="0.0175 0.004" group="3" rgba="0 0 0 0" friction="1.4 0.03 0.01" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="pen_holder_grasp_body" type="cylinder" pos="0 0 0.0" size="0.0155 0.028" group="3" rgba="0 0 0 0" friction="1.6 0.04 0.02" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <!-- Top rim trim & dark square hollow interior -->
      <geom name="pen_holder_rim" type="box" pos="0 0 0.028" size="0.016 0.016 0.002" rgba="0.14 0.28 0.52 1" contype="0" conaffinity="0"/>
      <geom name="pen_holder_inner_dark" type="box" pos="0 0 0.0298" size="0.0115 0.0115 0.0005" rgba="0.05 0.08 0.16 1" contype="0" conaffinity="0"/>
      <site name="pen_holder_site" pos="0 0 0.002" size="0.004" rgba="0.2 0.4 0.8 0.5" group="3"/>
    </body>

    <!-- Object 2: Small Cup (Short round espresso mug with white ceramic rim & side handle, 4.0 cm tall) -->
    <body name="cup" pos="0.22 -0.04 0.020">
      <freejoint name="cup_joint"/>
      <inertial pos="0 0 -0.003" mass="0.040" diaginertia="1.4e-5 1.4e-5 1.1e-5"/>
      <geom name="cup_base" type="cylinder" pos="0 0 -0.016" size="0.019 0.004" material="cup_mat" friction="1.4 0.03 0.01" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <geom name="cup_grasp_body" type="cylinder" pos="0 0 0.0" size="0.020 0.018" material="cup_mat" friction="1.6 0.04 0.02" solimp="0.95 0.99 0.001" solref="0.008 1"/>
      <!-- White ceramic lip and dark interior -->
      <geom name="cup_lip" type="cylinder" pos="0 0 0.0175" size="0.0215 0.002" rgba="0.95 0.93 0.88 1" contype="0" conaffinity="0"/>
      <geom name="cup_inner_dark" type="cylinder" pos="0 0 0.0192" size="0.0165 0.0005" rgba="0.22 0.10 0.08 1" contype="0" conaffinity="0"/>
      <!-- Mug side handle (visual loop on -X side so Y-axis gripper jaws never snag it) -->
      <geom name="cup_handle_top" type="box" pos="-0.024 0 0.009" size="0.006 0.003 0.002" material="cup_mat" contype="0" conaffinity="0"/>
      <geom name="cup_handle_bot" type="box" pos="-0.024 0 -0.007" size="0.006 0.003 0.002" material="cup_mat" contype="0" conaffinity="0"/>
      <geom name="cup_handle_bar" type="box" pos="-0.029 0 0.001" size="0.002 0.003 0.010" material="cup_mat" contype="0" conaffinity="0"/>
      <site name="cup_site" pos="0 0 0.002" size="0.004" rgba="0.9 0.3 0.2 0.5" group="3"/>
    </body>

    <!-- Object 3: Bowl (Smooth curved flared ceramic bowl with two-tone glaze, 11.2 cm rim diameter) -->
    <body name="bowl" pos="0.26 -0.14 0.004">
      <freejoint name="bowl_joint"/>
      <inertial pos="0 0 0.008" mass="0.180" diaginertia="1.6e-4 1.6e-4 2.8e-4"/>
      <!-- Smooth revolved visual meshes (outer teal ceramic + inner cream glaze) -->
      <geom name="bowl_visual_outer" type="mesh" mesh="bowl_outer" pos="0 0 -0.004" material="bowl_mat" contype="0" conaffinity="0" group="2"/>
      <geom name="bowl_visual_inner" type="mesh" mesh="bowl_inner" pos="0 0 -0.004" material="bowl_inner_mat" contype="0" conaffinity="0" group="2"/>
      <!-- Invisible concave collision cavity (group 3) with octagonal box floor to avoid CylinderBox normal inversion -->
      <geom name="bowl_base" type="box" pos="0 0 0.0" size="0.028 0.028 0.004" group="3" rgba="0 0 0 0" friction="1.2 0.03 0.01"/>
      <geom name="bowl_base_diag" type="box" pos="0 0 0.0" euler="0 0 0.7854" size="0.028 0.028 0.004" group="3" rgba="0 0 0 0" friction="1.2 0.03 0.01"/>
      <geom name="bowl_wall_0" type="box" pos="0.044 0.000 0.016" euler="0 -0.45 0.0000" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_1" type="box" pos="0.0311 0.0311 0.016" euler="0.318 -0.318 0.7854" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_2" type="box" pos="0.000 0.044 0.016" euler="0.45 0 1.5708" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_3" type="box" pos="-0.0311 0.0311 0.016" euler="0.318 0.318 2.3562" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_4" type="box" pos="-0.044 0.000 0.016" euler="0 0.45 3.1416" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_5" type="box" pos="-0.0311 -0.0311 0.016" euler="-0.318 0.318 -2.3562" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_6" type="box" pos="0.000 -0.044 0.016" euler="-0.45 0 -1.5708" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <geom name="bowl_wall_7" type="box" pos="0.0311 -0.0311 0.016" euler="-0.318 -0.318 -0.7854" size="0.003 0.019 0.018" group="3" rgba="0 0 0 0" friction="0.6 0.02 0.01"/>
      <site name="bowl_site" pos="0 0 0.012" size="0.005" rgba="0.1 0.8 0.6 0.5" group="3"/>
    </body>

    <!-- Object 4: Rubik's Cube (5.6 cm flat stacking pedestal with colored faces) -->
    <body name="rubiks_cube" pos="0.26 0.04 0.028">
      <freejoint name="rubiks_cube_joint"/>
      <inertial pos="0 0 0" mass="0.120" diaginertia="6.5e-5 6.5e-5 6.5e-5"/>
      <geom name="cube_core" type="box" pos="0 0 0" size="0.028 0.028 0.028" material="cube_core_mat" friction="1.3 0.03 0.01"/>
      <!-- Colored face stickers (visual only) -->
      <geom name="cube_top_white" type="box" pos="0 0 0.0281" size="0.025 0.025 0.0004" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
      <geom name="cube_front_red" type="box" pos="0.0281 0 0" size="0.0004 0.025 0.025" rgba="0.86 0.16 0.16 1" contype="0" conaffinity="0"/>
      <geom name="cube_back_orange" type="box" pos="-0.0281 0 0" size="0.0004 0.025 0.025" rgba="0.95 0.50 0.10 1" contype="0" conaffinity="0"/>
      <geom name="cube_left_green" type="box" pos="0 0.0281 0" size="0.025 0.0004 0.025" rgba="0.15 0.72 0.25 1" contype="0" conaffinity="0"/>
      <geom name="cube_right_blue" type="box" pos="0 -0.0281 0" size="0.025 0.0004 0.025" rgba="0.15 0.38 0.86 1" contype="0" conaffinity="0"/>
      <site name="rubiks_cube_site" pos="0 0 0.028" size="0.004" rgba="0.9 0.9 0.2 0.5" group="3"/>
    </body>
  </worldbody>
</mujoco>
